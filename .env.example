# Copy this to .env.local and fill in real values. Never commit .env.local.

# Stripe (get these from your Stripe dashboard: dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Price in cents for one video (e.g. 2500 = $25.00)
VIDEO_PRICE_CENTS=2500

# Your ComfyUI pod's proxy URL, e.g. https://9fh8dt1jr9xmn7-8188.proxy.runpod.net
COMFY_URL=https://your-pod-id-8188.proxy.runpod.net

# Where to send the finished video link (simplest MVP: log it, or wire up an email service later)
NOTIFY_EMAIL_FROM=you@yourdomain.com
